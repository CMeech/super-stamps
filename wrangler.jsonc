{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superstamps-local",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "superstamps-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/lib/db/migrations"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "env": {
    "preview": {
      "name": "superstamps-preview",
      "workers_dev": true,
      "preview_urls": true
    },
    "staging": {
      "name": "superstamps-staging",
      "workers_dev": true,
      "preview_urls": false
    },
    "production": {
      "name": "superstamps",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
